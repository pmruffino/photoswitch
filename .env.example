# Copy this file to .env and fill in values before running docker compose up.

# PostgreSQL credentials
POSTGRES_USER=psw
POSTGRES_PASSWORD=changeme_strong_password

# Encryption key for Immich API keys at rest.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=changeme_generate_a_real_key_here

# Host port the web UI listens on
WEB_PORT=2273

# Session lifetime in seconds (default 24h)
SESSION_TTL_SECONDS=86400

# Set to true when serving the app over HTTPS so the session cookie carries the
# Secure flag (cookie sent only over TLS). Leave unset/false for plain-HTTP LAN.
COOKIE_SECURE=false

# Host path for the staging volume (per-job working directory for downloads, extracts, and mapped files).
# On Unraid, point this at your NVMe cache pool to avoid the FUSE/shfs overhead.
STAGING_PATH=/mnt/cache/appdata/photoswitch/staging

# Tag of the ghcr.io/pmruffino/photoswitch-* images to pull. Defaults to "latest"
# (the most recent build off main). Pin to a specific version tag if you want
# controlled upgrades.
IMAGE_TAG=latest
